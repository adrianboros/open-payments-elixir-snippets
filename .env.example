# Copy this file to .env and replace the placeholders with your test wallet settings.
# Wallet-consuming commands will use these settings as they are implemented.
WALLET_ADDRESS='https://wallet.example/alice'
KEY_ID='your-registered-key-id'

# Use the path to your existing unencrypted Ed25519 PKCS#8 PEM private key.
PRIVATE_KEY_FILE='/absolute/path/to/your-private-key.pem'

# Alternatively, remove the file setting above and supply base64-encoded PEM.
# PRIVATE_KEY_BASE64=''
