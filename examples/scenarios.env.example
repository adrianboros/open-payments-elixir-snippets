# Copy to .env.scenarios in the project root; fill in actual wallet metadata.
# Load alongside .env with: --env-file .env --env-file .env.scenarios
# These example values are placeholders, not defaults for a live payment.
WALLET_ASSET_CODE='USD'
WALLET_ASSET_SCALE=2
# Sender can differ from the WALLET_ADDRESS that identifies the signing client.
SENDER_WALLET_ADDRESS='$wallet.example/sender'
SENDER_ASSET_CODE='USD'
SENDER_ASSET_SCALE=2
RECEIVER_WALLET_ADDRESS='$wallet.example/receiver'
RECEIVER_ASSET_CODE='EUR'
RECEIVER_ASSET_SCALE=2
# Integer strings in the asset's smallest units.
RECEIVE_VALUE=1
MAX_DEBIT_VALUE=2
# Replace these with callback URLs you control.
RECEIVER_FINISH_URI='https://client.example/return?state=receiver'
SENDER_FINISH_URI='https://client.example/return?state=sender'
# Canonical signing-client URL for the generic grant template.
CLIENT_WALLET_URL='https://wallet.example/client'
# Optional values for individual low-level commands.
SENDER_WALLET_URL='https://wallet.example/sender'
RECEIVER_WALLET_URL='https://wallet.example/receiver'
INCOMING_PAYMENT_URL='https://payments.example/incoming-payments/example'
QUOTE_URL='https://payments.example/quotes/example'

# Web Monetization direct contributions (integer minor units)
INCOMING_PAYMENT_URL=https://resources.example/incoming-payments/session-id
DEBIT_VALUE=1
# Optional labels for every payment in one test run
# TEST_SCENARIO=web-monetization
# TEST_RUN_ID=replace-with-a-unique-run-label

# A 10.00 budget per hour is independent from the 0.01 contribution size.
BUDGET_VALUE=1000
# Use a fresh UTC start and random nonce when requesting a live grant.
GRANT_INTERVAL=R/2026-11-24T00:00:00Z/PT1H
GRANT_NONCE=replace-with-a-fresh-random-nonce

# Placeholder wallet roles used only by the opt-in live acceptance runner.
EUR_WALLET_ADDRESS=https://wallet.example/eur
GBP_WALLET_ADDRESS=https://wallet.example/gbp
